<Window x:Class="DoItNow.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DoItNow.Converters"
        Title="DoItNow · Respaldos"
        Width="660" SizeToContent="Height" MaxHeight="860"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmento del selector Carpeta | Google Drive -->
        <Style x:Key="SegmentBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentFolderButton" TargetType="Button" BasedOn="{StaticResource SegmentBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolderMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentDriveButton" TargetType="Button" BasedOn="{StaticResource SegmentBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDriveMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedStrongBrush}"/>
        </Style>

        <Style x:Key="SegmentFolderText" TargetType="TextBlock" BasedOn="{StaticResource SegmentText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolderMode}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentDriveText" TargetType="TextBlock" BasedOn="{StaticResource SegmentText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDriveMode}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="24,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.35"
                              Color="{DynamicResource WindowShadowColor}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="🗄" FontSize="15" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Respaldos del vault" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="El vault se cifra con tu contraseña de respaldo antes de salir del equipo."
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click" ToolTip="Cerrar">
                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
            </Grid>

            <!-- Selector de destino -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="11"
                    Padding="3" HorizontalAlignment="Left" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SegmentFolderButton}"
                            Command="{Binding ShowFolderCommand}">
                        <TextBlock Text="Carpeta" Style="{StaticResource SegmentFolderText}"/>
                    </Button>
                    <Button Style="{StaticResource SegmentDriveButton}" Margin="2,0,0,0"
                            Command="{Binding ShowDriveCommand}">
                        <TextBlock Text="Google Drive" Style="{StaticResource SegmentDriveText}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Destino: carpeta sincronizada -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="14"
                    Padding="16,14" Margin="0,0,0,14"
                    Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="CARPETA DE RESPALDO" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Elige una carpeta de OneDrive, Dropbox o Drive de escritorio: el cliente de sincronización sube los respaldos por su cuenta."
                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource SurfaceInputBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                        <TextBlock Text="{Binding FolderLabel}" FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderLabel}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding ChooseFolderCommand}"
                                IsEnabled="{Binding IsNotBusy}">
                            <TextBlock Text="Elegir carpeta…" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentInkBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding OpenFolderCommand}"
                                IsEnabled="{Binding HasFolder}">
                            <TextBlock Text="Abrir carpeta" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Credenciales OAuth (solo Drive) -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="14"
                    Padding="16,14" Margin="0,0,0,14"
                    Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="CREDENCIALES DE GOOGLE CLOUD" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Crea un cliente OAuth de tipo «Aplicación de escritorio» y pega aquí sus datos. Se guardan cifrados en este equipo."
                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock Text="CLIENT ID" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource SurfaceInputBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                            CornerRadius="10" Margin="0,0,0,10">
                        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>
                    </Border>

                    <TextBlock Text="CLIENT SECRET" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource SurfaceInputBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                            CornerRadius="10">
                        <PasswordBox x:Name="SecretBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     FontSize="12" Padding="10,8"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Click="SaveCredentials_Click"
                                IsEnabled="{Binding IsNotBusy}">
                            <TextBlock Text="Guardar credenciales" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentInkBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding OpenConsoleCommand}">
                            <TextBlock Text="Abrir Google Cloud Console" FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="CancelCredentials_Click"
                                Visibility="{Binding HasCredentials, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Cancelar" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Cuenta de Google (solo Drive) -->
            <Border Grid.Row="4" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="14"
                    Padding="16,12" Margin="0,0,0,12"
                    Visibility="{Binding IsDriveMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding DestinationHint}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,3,12,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="Conectar cuenta" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentInkBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Desconectar" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding EditCredentialsCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Credenciales" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Acciones compartidas -->
            <Grid Grid.Row="5" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource AccentButton}"
                        Command="{Binding BackupNowCommand}" IsEnabled="{Binding CanInteract}">
                    <TextBlock Text="⬆ Respaldar ahora" FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource AccentInkBrush}"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}" IsEnabled="{Binding CanInteract}">
                    <TextBlock Text="↻ Actualizar" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnMutedBrush}"/>
                </Button>
            </Grid>

            <!-- Lista de respaldos -->
            <StackPanel Grid.Row="6">
                <TextBlock Text="{Binding BackupsHeader}" Style="{StaticResource SectionLabel}"/>

                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="12"
                        Padding="14,18"
                        Visibility="{Binding HasBackups, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Text="Todavía no hay respaldos en esta carpeta."
                                   Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Text="Todavía no hay respaldos en Drive. Conecta la cuenta y pulsa «Respaldar ahora»."
                                   Visibility="{Binding IsDriveMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10"
                                        Padding="12,9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="9.5"
                                                       Foreground="{DynamicResource TextMutedStrongBrush}"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding DisplayDate, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding DisplaySize, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Padding="10,6"
                                                    ToolTip="Restaurar este respaldo"
                                                    IsEnabled="{Binding DataContext.CanInteract,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.RestoreCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="↺" FontSize="12"
                                                           Foreground="{DynamicResource TextOnMutedBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="10,6"
                                                    Margin="6,0,0,0" ToolTip="Eliminar respaldo"
                                                    IsEnabled="{Binding DataContext.CanInteract,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="🗑" FontSize="11"
                                                           Foreground="{DynamicResource DangerTextBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding StatusMessage}" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
