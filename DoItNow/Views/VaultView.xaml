<UserControl x:Class="DoItNow.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:conv="clr-namespace:DoItNow.Converters"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="980">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>

        <Style x:Key="VaultTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VaultPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VaultGhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VaultIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedStrongBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VaultDangerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="22" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="Key" Width="20" Height="20"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Bóveda de claves" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9"
                                Padding="9,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SecurityBadge}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedStrongBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Guarda API keys, tokens y contraseñas cifradas con AES-GCM. Se muestran solo cuando tú lo pides."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="28,2,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportVaultCommand}" Style="{StaticResource VaultGhostButton}"
                            Content="⬆ Exportar" Margin="0,0,6,0"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding ImportVaultCommand}" Style="{StaticResource VaultGhostButton}"
                            Content="⬇ Importar" Margin="0,0,6,0"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding ImportAwsCredentialsCommand}" Style="{StaticResource VaultGhostButton}"
                            Content="☁ AWS" Margin="0,0,6,0"
                            ToolTip="Importar credenciales de AWS (CSV de IAM o archivo credentials)"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding SetupMasterPasswordCommand}" Style="{StaticResource VaultGhostButton}"
                            Content="🔐 Activar contraseña" Margin="0,0,6,0"
                            Visibility="{Binding CanConfigurePassword, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding ChangeMasterPasswordCommand}" Style="{StaticResource VaultGhostButton}"
                            Content="🔑 Cambiar contraseña" Margin="0,0,6,0"
                            Visibility="{Binding CanManageMasterPassword, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding RemoveMasterPasswordCommand}" Style="{StaticResource VaultDangerButton}"
                            Content="Quitar" Margin="0,0,6,0"
                            Visibility="{Binding CanManageMasterPassword, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding LockCommand}" Style="{StaticResource VaultGhostButton}"
                            Content="🔒 Bloquear" Margin="0,0,6,0"
                            Visibility="{Binding CanManageMasterPassword, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding NewEntryCommand}" Style="{StaticResource VaultPrimaryButton}"
                            Content="+ Nueva clave"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </Grid>

            <!-- Locked state -->
            <Grid Grid.Row="1" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="20"
                        MaxWidth="440" Padding="36,32"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="🔒" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>

                        <TextBlock Text="Bóveda bloqueada" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="Introduce tu contraseña maestra para descifrar tus claves."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="CONTRASEÑA MAESTRA" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource SurfaceInputBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                CornerRadius="10" Margin="0,0,0,10">
                            <PasswordBox x:Name="UnlockPasswordBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         FontSize="13" Padding="12,9"
                                         KeyDown="UnlockPassword_KeyDown"/>
                        </Border>

                        <TextBlock Text="{Binding UnlockError}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding UnlockError, Converter={StaticResource StringNotEmptyToVis}}"/>

                        <Button Style="{StaticResource VaultPrimaryButton}" Click="Unlock_Click"
                                Content="Desbloquear bóveda" Padding="18,10"/>

                        <TextBlock Text="La contraseña maestra no se guarda en disco. Si la olvidas, las claves no se pueden recuperar."
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Unlocked state -->
            <Grid Grid.Row="1" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Entries list -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="18" Padding="14,12" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="TUS CLAVES" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="9" Padding="8,2">
                                <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} entradas'}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedStrongBrush}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource VaultTextBox}" Padding="10,7"/>
                                <StackPanel Orientation="Horizontal" Margin="11,0,0,0"
                                            VerticalAlignment="Center" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <fa:IconImage Icon="Search" Width="10" Height="10"
                                                  Foreground="{DynamicResource TextMutedBrush}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Buscar claves..." FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredEntries}"
                                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="Transparent" BorderThickness="1.5"
                                                            CornerRadius="14" Padding="11,9">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10"
                                                    Background="{DynamicResource ChipBrush}" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding EntryType}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextMutedStrongBrush}"/>
                                                    <TextBlock Text="  ·  " FontSize="9"
                                                               Foreground="{DynamicResource TextSubtleBrush}"/>
                                                    <TextBlock Text="{Binding Username}" FontSize="9"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty search state -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding ShowListEmptyState, Converter={StaticResource BoolToVis}}"
                                        Margin="0,18,0,18">
                                <TextBlock Text="🔎" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding EmptyListTitle}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding EmptyListSubtitle}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Detail / editor -->
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="18" Padding="20,16">
                    <Grid>
                        <!-- Onboarding (empty vault) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ShowOnboardingState, Converter={StaticResource BoolToVis}}"
                                    Margin="0,40,0,40" MaxWidth="420">
                            <Border Width="76" Height="76" CornerRadius="38"
                                    Background="{DynamicResource ChipBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="🔑" FontSize="32"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Tu bóveda está vacía" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center"
                                       Margin="0,14,0,4"/>
                            <TextBlock Text="Guarda aquí tus API keys, tokens y contraseñas. Cada entrada se cifra con AES-256-GCM antes de tocar el disco."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <Button Command="{Binding NewEntryCommand}" Style="{StaticResource VaultPrimaryButton}"
                                    Content="+ Crear primera clave" Margin="0,16,0,0" Padding="18,10"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Empty detail state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ShowDetailEmptyState, Converter={StaticResource BoolToVis}}"
                                    Margin="0,40,0,40">
                            <TextBlock Text="🔑" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Selecciona una clave" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Elige una entrada de la lista o crea una nueva. El secreto permanece oculto hasta que lo reveles."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Editor -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsEditorEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- DPAPI hint -->
                                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="12"
                                        Padding="12,8" Margin="0,0,0,12"
                                        Visibility="{Binding UsesWindowsProtection, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="🛡 Protegida por Windows (DPAPI). Configura una contraseña maestra para exportar e importar en otros equipos."
                                               FontSize="10" Foreground="{DynamicResource TextMutedStrongBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Title + type -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="TÍTULO" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource VaultTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="TIPO" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding EntryTypes}"
                                                  SelectedItem="{Binding EditEntryType, Mode=TwoWay}"
                                                  Padding="10,7"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Username + URL -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="USUARIO / CUENTA" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                        <Grid>
                                            <TextBox Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource VaultTextBox}" Padding="10,7,36,7"/>
                                            <Button Command="{Binding CopyUsernameCommand}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="8,4" Margin="0,0,2,0"
                                                    ToolTip="Copiar usuario">
                                                <TextBlock Text="📋" FontSize="11"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="URL / SERVICIO" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource VaultTextBox}" Padding="10,7"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Secret -->
                                <TextBlock Text="SECRETO / TOKEN" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding EditSecret, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource VaultTextBox}"
                                             FontFamily="Consolas" Padding="10,7,36,7"
                                             Visibility="{Binding IsSecretVisible, Converter={StaticResource BoolToVis}}"/>

                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceInputBrush}"
                                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="12,9" MinHeight="34"
                                            Visibility="{Binding IsSecretVisible, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="{Binding MaskedSecret}" FontSize="12"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource TextMutedStrongBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <Button Grid.Column="1" Command="{Binding ToggleSecretCommand}"
                                            Style="{StaticResource VaultGhostButton}" Content="👁"
                                            Margin="8,0,0,0" ToolTip="Mostrar u ocultar el secreto"/>
                                    <Button Grid.Column="2" Command="{Binding CopySecretCommand}"
                                            Style="{StaticResource VaultGhostButton}" Content="📋"
                                            Margin="6,0,0,0" ToolTip="Copiar secreto"/>
                                </Grid>

                                <!-- Notes -->
                                <TextBlock Text="NOTAS (SE CIFRAN TAMBIÉN)" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource VaultTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="96" VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,14"/>

                                <!-- Attachments -->
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ARCHIVOS ADJUNTOS" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8"
                                                Padding="6,1" Margin="8,0,0,0"
                                                Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding EditAttachments.Count}"
                                                       FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedStrongBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Command="{Binding AddAttachmentCommand}"
                                            Style="{StaticResource VaultGhostButton}"
                                            Content="📎 Adjuntar archivo" Padding="10,5"
                                            HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="12"
                                        Padding="12,10" Margin="0,0,0,6"
                                        Visibility="{Binding HasAttachments, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="Adjunta archivos cifrados: credenciales de AWS, certificados, JSON de servicio… Máximo 10 MB por archivo."
                                               FontSize="10" Foreground="{DynamicResource TextMutedStrongBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <ItemsControl ItemsSource="{Binding EditAttachments}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceInputBrush}"
                                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="10,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="📄" FontSize="13"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="9" Foreground="{DynamicResource TextMutedBrush}">
                                                            <Run Text="{Binding SizeLabel, Mode=OneWay}"/>
                                                            <Run Text=" · cifrado AES-GCM"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource VaultIconButton}"
                                                                Content="⤓" ToolTip="Guardar una copia descifrada"
                                                                Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource VaultIconButton}"
                                                                Content="🗑" ToolTip="Eliminar adjunto"
                                                                Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Actions -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Command="{Binding SaveEntryCommand}"
                                            Style="{StaticResource VaultPrimaryButton}" Content="💾 Guardar clave"/>
                                    <Button Grid.Column="1" Command="{Binding DeleteEntryCommand}"
                                            Style="{StaticResource VaultDangerButton}" Content="🗑 Eliminar"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}"
                                               FontSize="10" Foreground="{DynamicResource TextMutedStrongBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               HorizontalAlignment="Right" MaxWidth="300"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Footer status -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="4,12,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SecurityStatusText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="  ·  AES-256-GCM + PBKDF2" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
