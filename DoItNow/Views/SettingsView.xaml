<UserControl x:Class="DoItNow.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:conv="clr-namespace:DoItNow.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="22" Padding="32,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="Cog" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Configuración del Sistema" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Gestiona la arquitectura de IA (Híbrida: Local con Ollama o Nube ultrarrápida con Groq) y la base de datos."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="32,4,0,0"/>
                </StackPanel>

                <!-- Section 1: AI Provider Mode (Híbrido) -->
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="18" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <fa:IconImage Icon="SlidersH" Width="16" Height="16" Foreground="{DynamicResource TextOnMutedBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Arquitectura del Motor de IA" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="MODO DE OPERACIÓN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding AiProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                  FontSize="13" Padding="10,8" Margin="0,0,0,6"/>

                        <TextBlock Text="• 'Auto': Usa Ollama local si está activo; si no, hace fallback automático a la nube rápida para que cualquier reclutador o usuario pueda probarlo sin instalar nada."
                                   FontSize="11" Foreground="{DynamicResource TextMutedStrongBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Section 2: Groq Cloud (Free Cloud API) -->
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="18" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Bolt" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Groq Cloud (Nube Gratuita - Ideal para Portafolio)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding OpenGroqConsoleCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="🔑 Obtener clave gratis en console.groq.com ↗" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnMutedBrush}"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="API KEY DE GROQ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Clave enmascarada por defecto -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="12,9" MinHeight="38"
                                    Visibility="{Binding IsApiKeyVisible, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="{Binding MaskedGroqApiKey}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedStrongBrush}"
                                           FontFamily="Consolas"/>
                            </Border>

                            <!-- Edición explícita de la clave -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding GroqApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                     FontSize="13" Padding="12,8"
                                     Visibility="{Binding IsApiKeyVisible, Converter={StaticResource BoolToVis}}">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></TextBox.Resources>
                            </TextBox>

                            <Button Grid.Column="1" Command="{Binding ToggleApiKeyVisibilityCommand}"
                                    Background="{DynamicResource SurfaceMutedBrush}" BorderThickness="0"
                                    Cursor="Hand" Padding="12,9" Margin="8,0,0,0" ToolTip="Mostrar u ocultar la clave">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <TextBlock Text="👁" FontSize="13" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="Responde a más de 500 palabras/segundo usando Llama 3.3 sin consumir RAM en la máquina del usuario."
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Section 3: Ollama Local Configuration -->
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="18" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <fa:IconImage Icon="Robot" Width="16" Height="16" Foreground="{DynamicResource TextOnMutedBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Ollama (Servidor Local Privado)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- URL Endpoint -->
                        <TextBlock Text="ENDPOINT LOCAL (DEFAULT: http://localhost:11434)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding OllamaUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                 FontSize="13" Padding="12,8" Margin="0,0,0,12">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></TextBox.Resources>
                        </TextBox>

                        <!-- Selected Model & Refresh -->
                        <TextBlock Text="MODELO LOCAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                      FontSize="13" Padding="10,8"/>

                            <Button Grid.Column="1" Command="{Binding RefreshModelsCommand}"
                                    Background="{DynamicResource PrimaryBrush}" BorderThickness="0" Cursor="Hand" Padding="14,8" Margin="10,0,0,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="SyncAlt" Width="12" Height="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Detectar Modelos" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 4: Database Storage -->
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="18" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <fa:IconImage Icon="Database" Width="16" Height="16" Foreground="{DynamicResource TextOnMutedBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Base de Datos Local (SQLite)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="UBICACIÓN DEL ARCHIVO DE BASE DE DATOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True"
                                     Background="{DynamicResource SurfaceDisabledBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                     FontSize="11" Padding="12,8">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></TextBox.Resources>
                            </TextBox>

                            <Button Grid.Column="1" Command="{Binding OpenDatabaseFolderCommand}"
                                    Background="{DynamicResource PrimaryBrush}" BorderThickness="0" Cursor="Hand" Padding="14,8" Margin="10,0,0,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Folder" Width="12" Height="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Abrir Carpeta" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 5: Demo Data (portfolio ready) -->
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="18" Padding="20" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <fa:IconImage Icon="Magic" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Datos de demostración" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Rellena la agenda con tareas realistas (idempotente) para probar filtros, métricas y capturar el portafolio con la app llena."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding LoadDemoDataCommand}"
                                Background="{DynamicResource PrimaryBrush}" BorderThickness="0"
                                Cursor="Hand" Padding="18,10" VerticalAlignment="Center">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Plus" Width="12" Height="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="Cargar demo" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Status Feedback & Save Button -->
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextStrongBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <Button Grid.Column="1" Command="{Binding SaveSettingsCommand}"
                            Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Padding="26,12">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Save" Width="14" Height="14" Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Guardar Configuración" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentInkBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
