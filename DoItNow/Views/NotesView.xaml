<UserControl x:Class="DoItNow.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:conv="clr-namespace:DoItNow.Converters"
             xmlns:controls="clr-namespace:DoItNow.Controls"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="980">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="NoteTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotePrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteGhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteDangerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="22" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="Code" Width="20" Height="20"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Notas de código" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9"
                                Padding="9,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AvalonEdit · offline" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedStrongBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Pega fragmentos con resaltado de sintaxis, números de línea y exportación a archivos reales."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="28,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="210" Margin="0,0,8,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NoteTextBox}" Padding="10,7"/>
                        <StackPanel Orientation="Horizontal" Margin="11,0,0,0"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <fa:IconImage Icon="Search" Width="10" Height="10"
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Buscar notas..." FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Button Command="{Binding NewNoteCommand}" Style="{StaticResource NotePrimaryButton}"
                            Content="+ Nueva nota" Padding="14,8"/>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Notes list -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="18" Padding="14,12" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="MIS NOTAS" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="9" Padding="8,2">
                                <TextBlock Text="{Binding Notes.Count, StringFormat='{}{0} notas'}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedStrongBrush}"/>
                            </Border>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredNotes}"
                                 SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="Transparent" BorderThickness="1.5"
                                                        CornerRadius="14" Padding="11,9">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource ChipBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding LanguageIcon}" FontSize="10" FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextOnMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Language}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedStrongBrush}"/>
                                                <TextBlock Text="  ·  " FontSize="9"
                                                           Foreground="{DynamicResource TextSubtleBrush}"/>
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:dd MMM HH:mm}'}"
                                                           FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty search state -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ShowListEmptyState, Converter={StaticResource BoolToVis}}"
                                    Margin="0,18,0,18">
                            <TextBlock Text="🔎" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding EmptyListTitle}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding EmptyListSubtitle}"
                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Editor -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="18" Padding="18,14">
                    <Grid>
                        <!-- Onboarding (no notes) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ShowOnboardingState, Converter={StaticResource BoolToVis}}"
                                    Margin="0,40,0,40" MaxWidth="420">
                            <Border Width="76" Height="76" CornerRadius="38"
                                    Background="{DynamicResource ChipBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="⌨" FontSize="32"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Tu bloc de notas de código" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center"
                                       Margin="0,14,0,4"/>
                            <TextBlock Text="Crea una nota, pega el fragmento y elige el lenguaje. El editor añade números de línea y resaltado de sintaxis."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <Button Command="{Binding NewNoteCommand}" Style="{StaticResource NotePrimaryButton}"
                                    Content="+ Crear primera nota" Margin="0,16,0,0" Padding="18,10"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ShowEditorEmptyState, Converter={StaticResource BoolToVis}}"
                                    Margin="0,40,0,40">
                            <TextBlock Text="⌨" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Selecciona o crea una nota" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="El editor detecta el lenguaje y resalta la sintaxis automáticamente."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Editor surface -->
                        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="TÍTULO DE LA NOTA" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NoteTextBox}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="LENGUAJE" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Languages}"
                                              SelectedItem="{Binding EditLanguage, Mode=TwoWay}"
                                              Padding="10,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Command="{Binding SaveNoteCommand}" Style="{StaticResource NotePrimaryButton}"
                                            Content="{Binding SaveButtonText}" Margin="0,0,6,0"/>
                                    <Button Command="{Binding CopyContentCommand}" Style="{StaticResource NoteGhostButton}"
                                            Content="📋" ToolTip="Copiar contenido" Margin="0,0,6,0"/>
                                    <Button Command="{Binding DuplicateNoteCommand}" Style="{StaticResource NoteGhostButton}"
                                            Content="⧉" ToolTip="Duplicar nota" Margin="0,0,6,0"/>
                                    <Button Command="{Binding ExportNoteCommand}" Style="{StaticResource NoteGhostButton}"
                                            Content="⬇" ToolTip="Exportar archivo" Margin="0,0,6,0"/>
                                    <Button Command="{Binding DeleteNoteCommand}" Style="{StaticResource NoteDangerButton}"
                                            Content="🗑" ToolTip="Eliminar nota"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Code editor -->
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceInputBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="2">
                                <controls:CodeEditor
                                    x:Name="Editor"
                                    TextContent="{Binding EditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SyntaxLanguage="{Binding EditLanguage}"
                                    ShowLineNumbers="True"/>
                            </Border>

                            <!-- Footer -->
                            <Grid Grid.Row="2" Margin="2,8,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding EditorStatus}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Background="{DynamicResource SurfaceMutedBrush}"
                                        CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding DirtyLabel}" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedStrongBrush}"/>
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
