<Window x:Class="DoItNow.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoItNow · Perfiles"
        Width="980" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/DoItNow.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Tarjeta de perfil: superficie suave, esquinas redondeadas y hover. -->
        <Style x:Key="ProfileCardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource BorderMediumBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón principal con acento lima. -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario de superficie. -->
        <Style x:Key="MutedButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de texto plano para acciones delicadas. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Caja de texto con borde temático. -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="26" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="6" Opacity="0.35"
                              Color="{DynamicResource WindowShadowColor}"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================ -->
            <!-- LEFT: BRAND PANEL                                            -->
            <!-- ============================================================ -->
            <Grid Grid.Column="0" Background="{DynamicResource PrimaryBrush}"
                  MouseLeftButtonDown="Brand_MouseLeftButtonDown">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,380,640" RadiusX="26" RadiusY="26"/>
                </Grid.Clip>

                <!-- Decoración: anillos y halos suaves -->
                <Ellipse Width="430" Height="430" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-160,-190,0" Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="1" Opacity="0.16"/>
                <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-140,-110" Fill="{DynamicResource AccentBrush}" Opacity="0.07"/>
                <Ellipse Width="140" Height="140" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="34,0,0,-60" Stroke="#FFFFFF" StrokeThickness="1" Opacity="0.10"/>

                <StackPanel Margin="42,54,42,40">
                    <!-- Marca: anillos concéntricos -->
                    <Grid Width="58" Height="58" HorizontalAlignment="Left">
                        <Ellipse Width="58" Height="58" Stroke="#FFFFFF" StrokeThickness="2.5" Opacity="0.95"/>
                        <Ellipse Width="34" Height="34" Stroke="#FFFFFF" StrokeThickness="2" Opacity="0.75"/>
                        <Ellipse Width="14" Height="14" Fill="{DynamicResource AccentBrush}"/>
                    </Grid>

                    <TextBlock Text="DoItNow" FontSize="30" FontWeight="Bold" Foreground="White"
                               Margin="0,20,0,4" FontFamily="Segoe UI"/>
                    <TextBlock Text="Tu sistema operativo de productividad, en local."
                               FontSize="12.5" Foreground="{DynamicResource HeaderSubtleBrush}"
                               TextWrapping="Wrap" FontFamily="Segoe UI"/>

                    <Border Height="1" Background="#FFFFFF" Opacity="0.16" Margin="0,30,0,26"/>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Un perfil, una base de datos" FontSize="12"
                                           FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Tareas, notas y chat separados por espacio."
                                           FontSize="10.5" Foreground="{DynamicResource HeaderSubtleBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Bóveda cifrada por perfil" FontSize="12"
                                           FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="AES-256-GCM con contraseña maestra opcional."
                                           FontSize="10.5" Foreground="{DynamicResource HeaderSubtleBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Sin cuenta ni servidor" FontSize="12"
                                           FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Todo se queda en este equipo."
                                           FontSize="10.5" Foreground="{DynamicResource HeaderSubtleBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="DOITNOW · LOCAL PROFILES" FontSize="8.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderSubtleBrush}" Opacity="0.75"
                               Margin="0,40,0,0" FontFamily="Segoe UI"/>
                </StackPanel>
            </Grid>

            <!-- ============================================================ -->
            <!-- RIGHT: PROFILE / LOGIN FLOW                                  -->
            <!-- ============================================================ -->
            <Grid Grid.Column="1" Margin="34,22,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="PERFILES LOCALES" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource LinkButton}" Click="Close_Click" ToolTip="Cerrar"
                            AutomationProperties.Name="Cerrar">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">

                    <!-- ==================================================== -->
                    <!-- 1) PROFILE LIST                                      -->
                    <!-- ==================================================== -->
                    <Grid x:Name="ProfilesView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="¿Quién está usando DoItNow?" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Elige un perfil para continuar o crea uno nuevo."
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,4,0">
                            <ItemsControl x:Name="ProfileList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ProfileCardButton}"
                                                Tag="{Binding}" Click="ProfileCard_Click"
                                                AutomationProperties.Name="{Binding DisplayName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="42" Height="42" CornerRadius="21"
                                                        Background="{DynamicResource PrimaryBrush}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="14,0,10,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LastLoginLabel}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="{DynamicResource ChipBrush}"
                                                        CornerRadius="8" Padding="8,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AccessLabel}" FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextOnMutedBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource AccentButton}" Click="ShowCreate_Click"
                                    AutomationProperties.Name="Crear perfil">
                                <TextBlock Text="+  Crear perfil" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentInkBrush}"/>
                            </Button>
                            <TextBlock x:Name="ProfilesHint" Text=""
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ==================================================== -->
                    <!-- 2) UNLOCK SELECTED PROFILE                           -->
                    <!-- ==================================================== -->
                    <Grid x:Name="UnlockView" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Left">
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                    Click="ShowProfiles_Click" Margin="0,0,0,18"
                                    AutomationProperties.Name="Otros perfiles">
                                <TextBlock Text="←  Otros perfiles" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="54" Height="54" CornerRadius="27"
                                        Background="{DynamicResource PrimaryBrush}">
                                    <TextBlock x:Name="UnlockInitial" Text="?" FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock x:Name="UnlockName" Text="Perfil" FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                    <TextBlock x:Name="UnlockAccess" Text="Protegido con contraseña"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,24,0,0">
                                <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <PasswordBox x:Name="UnlockPassword"
                                                 Style="{StaticResource FieldPassword}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="UnlockError" Text="" Visibility="Collapsed"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerTextBrush}"
                                       TextWrapping="Wrap" Margin="0,9,0,0"/>

                            <Button Style="{StaticResource AccentButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Left" Click="Unlock_Click"
                                    AutomationProperties.Name="Entrar">
                                <TextBlock Text="Entrar" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentInkBrush}"/>
                            </Button>

                            <WrapPanel Margin="0,22,0,0">
                                <Button Style="{StaticResource LinkButton}" Click="ChangePassword_Click"
                                        AutomationProperties.Name="Cambiar contraseña">
                                    <TextBlock Text="Cambiar contraseña" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <TextBlock Text="·" FontSize="10.5" Margin="6,0"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <Button Style="{StaticResource LinkButton}" Click="RemovePassword_Click"
                                        AutomationProperties.Name="Quitar contraseña">
                                    <TextBlock Text="Quitar contraseña" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <TextBlock Text="·" FontSize="10.5" Margin="6,0"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <Button Style="{StaticResource LinkButton}" Click="DeleteProfile_Click"
                                        AutomationProperties.Name="Eliminar perfil">
                                    <TextBlock Text="Eliminar perfil" FontSize="10.5"
                                               Foreground="{DynamicResource DangerTextBrush}"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ==================================================== -->
                    <!-- 3) CREATE PROFILE                                    -->
                    <!-- ==================================================== -->
                    <Grid x:Name="CreateView" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="380" HorizontalAlignment="Left" Margin="0,0,4,0">
                                <Button x:Name="CreateBackButton" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Click="ShowProfiles_Click"
                                        Margin="0,0,0,16" AutomationProperties.Name="Otros perfiles">
                                    <TextBlock Text="←  Otros perfiles" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>

                                <TextBlock Text="Nuevo perfil" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Cada perfil guarda sus tareas, notas y bóveda en su propia base."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,5,0,18"/>

                                <TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <TextBox x:Name="NewName" Style="{StaticResource FieldBox}"
                                             MaxLength="32"/>
                                </Border>

                                <TextBlock Text="CONTRASEÑA (OPCIONAL)" Style="{StaticResource FieldLabel}"
                                           Margin="0,16,0,5"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <PasswordBox x:Name="NewPassword"
                                                 Style="{StaticResource FieldPassword}"/>
                                </Border>
                                <TextBlock Text="Mínimo 8 caracteres. Déjalo vacío para entrar sin contraseña."
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>

                                <TextBlock Text="REPITE LA CONTRASEÑA" Style="{StaticResource FieldLabel}"
                                           Margin="0,14,0,5"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <PasswordBox x:Name="ConfirmPassword"
                                                 Style="{StaticResource FieldPassword}"/>
                                </Border>

                                <TextBlock x:Name="CreateError" Text="" Visibility="Collapsed"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerTextBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"/>

                                <Button Style="{StaticResource AccentButton}" Margin="0,18,0,0"
                                        HorizontalAlignment="Left" Click="Create_Click"
                                        AutomationProperties.Name="Crear y entrar">
                                    <TextBlock Text="Crear y entrar" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentInkBrush}"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2" Margin="0,16,0,0"
                           Text="La contraseña bloquea el acceso a la app; no cifra toda la base de datos. La bóveda tiene su propio cifrado."
                           FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Border>
</Window>
