<UserControl x:Class="DoItNow.Views.DocToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:conv="clr-namespace:DoItNow.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:StringEmptyToVisibilityConverter x:Key="StrEmptyVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyVis"/>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
        <conv:FileKindToBrushConverter x:Key="FileKindBrush"/>

        <!-- Pestaña del conmutador Convertir / Extraer -->
        <Style x:Key="ModeTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeTabConvert" TargetType="Button" BasedOn="{StaticResource ModeTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConvertMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeTabExtract" TargetType="Button" BasedOn="{StaticResource ModeTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConvertMode}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedStrongBrush}"/>
        </Style>

        <Style x:Key="TabLabelActive" TargetType="TextBlock" BasedOn="{StaticResource TabLabel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConvertMode}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabLabelActiveInverse" TargetType="TextBlock" BasedOn="{StaticResource TabLabel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConvertMode}" Value="False">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabIcon" TargetType="fa:IconImage">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedStrongBrush}"/>
        </Style>

        <Style x:Key="TabIconActive" TargetType="fa:IconImage" BasedOn="{StaticResource TabIcon}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConvertMode}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabIconActiveInverse" TargetType="fa:IconImage" BasedOn="{StaticResource TabIcon}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConvertMode}" Value="False">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón principal del convertidor (añadir / convertir) -->
        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de archivo en la cola -->
        <DataTemplate x:Key="ConversionJobRow">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12,9"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="34" CornerRadius="8"
                            Background="{Binding ExtensionLabel, Converter={StaticResource FileKindBrush}}"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ExtensionLabel}" FontSize="9" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedStrongBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ComboBox Grid.Column="2" ItemsSource="{Binding Targets}"
                              SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                              Style="{StaticResource CleanComboBox}"
                              DisplayMemberPath="Label" Width="118" Height="30"
                              VerticalAlignment="Center" Margin="8,0,4,0"/>

                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="7"
                            ToolTip="Quitar de la cola"
                            Command="{Binding DataContext.RemoveJobCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <fa:IconImage Icon="Trash" Width="11" Height="11"
                                      Foreground="{DynamicResource TextMutedBrush}" Opacity="0.7"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="22" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Conmutador de modo -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource ModeTabConvert}" Command="{Binding ShowConverterCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="SyncAlt" Style="{StaticResource TabIconActive}"/>
                        <TextBlock Text="Convertir" Style="{StaticResource TabLabelActive}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ModeTabExtract}" Command="{Binding ShowExtractorCommand}"
                        Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="Magic" Style="{StaticResource TabIconActiveInverse}"/>
                        <TextBlock Text="Extraer tareas (IA)" Style="{StaticResource TabLabelActiveInverse}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ===================== MODO CONVERTIR ===================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsConvertMode, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabecera -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="FileAlt" Width="20" Height="20"
                                          Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,9,0"/>
                            <TextBlock Text="Conversión local de documentos" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="PDF, Word, Excel, CSV, JSON, Markdown y texto. Nada se sube a internet."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="29,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10"
                                Padding="10,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="100% offline" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedStrongBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding AddFilesCommand}" Style="{StaticResource PrimaryAction}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Plus" Width="11" Height="11"
                                              Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="Añadir archivos" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Cola + vista previa -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cola -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="16"
                            Padding="14,12" Margin="0,0,12,0"
                            AllowDrop="True" Drop="Convert_Drop" DragOver="Convert_DragOver">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="COLA" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8"
                                            Padding="7,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Jobs.Count}" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedStrongBrush}"/>
                                    </Border>
                                    <TextBlock Text="Arrastra archivos aquí" FontSize="10"
                                               Foreground="{DynamicResource TextSubtleBrush}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasJobs, Converter={StaticResource InvBoolToVis}}"/>
                                </StackPanel>

                                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                        Command="{Binding ClearJobsCommand}"
                                        Visibility="{Binding Jobs.Count, Converter={StaticResource IntToVis}}">
                                    <TextBlock Text="Vaciar" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedStrongBrush}"/>
                                </Button>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Jobs}"
                                     SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource ConversionJobRow}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Estado vacío -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding HasJobs, Converter={StaticResource InvBoolToVis}}">
                                <fa:IconImage Icon="FileCirclePlus" Width="34" Height="34"
                                              Foreground="{DynamicResource TextSubtleBrush}"
                                              HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Arrastra tus documentos aquí" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="o pulsa «Añadir archivos». Se convierten en tu equipo."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Vista previa -->
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="16"
                            Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="VISTA PREVIA" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PreviewTitle}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedStrongBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           MaxWidth="210" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                                <Grid>
                                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="Transparent" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="11" Padding="12"
                                             Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding PreviewText, Converter={StaticResource StrEmptyVis}}">
                                        <fa:IconImage Icon="FileLines" Width="26" Height="26"
                                                      Foreground="{DynamicResource TextSubtleBrush}"
                                                      HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Sin vista previa" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Convierte un archivo para ver el resultado."
                                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="200"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding SelectedJob.OutputPath,
                                            Converter={StaticResource StrNotEmptyVis},
                                            FallbackValue=Collapsed}">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenSelectedOutputCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:IconImage Icon="FileAlt" Width="11" Height="11"
                                                      Foreground="{DynamicResource TextMutedStrongBrush}"
                                                      Margin="0,0,6,0"/>
                                        <TextBlock Text="Abrir archivo" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedStrongBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenOutputFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:IconImage Icon="FolderOpen" Width="11" Height="11"
                                                      Foreground="{DynamicResource TextMutedStrongBrush}"
                                                      Margin="0,0,6,0"/>
                                        <TextBlock Text="Abrir carpeta" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedStrongBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Barra inferior -->
                <Border Grid.Row="2" Background="{DynamicResource PrimaryBrush}" CornerRadius="16" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConverterStatus}" FontSize="12" Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <fa:IconImage Icon="Folder" Width="10" Height="10" Foreground="White" Opacity="0.7"
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding OutputFolderDisplay}" FontSize="10"
                                           Foreground="White" Opacity="0.75"
                                           MaxWidth="330" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButton}" Padding="8,2" Margin="4,0,0,0"
                                        Command="{Binding ChooseOutputFolderCommand}">
                                    <TextBlock Text="Cambiar" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextDecorations="Underline"/>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="8,2"
                                        Command="{Binding ResetOutputFolderCommand}"
                                        Visibility="{Binding UseSourceFolder, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="Restablecer" FontSize="10"
                                               Foreground="White" Opacity="0.7"
                                               TextDecorations="Underline"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding ConvertAllCommand}"
                                Style="{StaticResource PrimaryAction}"
                                Background="{DynamicResource AccentBrush}" Padding="20,10"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="SyncAlt" Width="12" Height="12"
                                              Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Convertir" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentInkBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== MODO EXTRAER TAREAS ===================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsExtractMode, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabecera -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Magic" Width="20" Height="20"
                                          Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,9,0"/>
                            <TextBlock Text="Extrae tareas desde tus documentos" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Carga un archivo de texto y la IA detectará las tareas accionables."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="29,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding ClearCommand}"
                            Background="{DynamicResource SurfaceMutedBrush}" BorderThickness="0"
                            Cursor="Hand" Padding="14,6" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style>
                        </Button.Resources>
                        <TextBlock Text="Limpiar" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>

                <!-- Selector de archivo -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderMediumBrush}" BorderThickness="1.5"
                        CornerRadius="16" Padding="20,14" Margin="0,0,0,14"
                        AllowDrop="True" Drop="FileDrop_Drop" DragOver="FileDrop_DragOver">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="FileLines" Width="16" Height="16"
                                              Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedFilePath, FallbackValue='Arrastra un archivo aquí o haz clic en Seleccionar...'}"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="24,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding SelectFileCommand}"
                                Background="{DynamicResource PrimaryBrush}" BorderThickness="0"
                                Cursor="Hand" Padding="18,9" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="FolderOpen" Width="13" Height="13"
                                              Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Seleccionar archivo" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Vista previa -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="VISTA PREVIA DEL CONTENIDO" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding WordCount, StringFormat='{}{0} palabras'}" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBox Text="{Binding ExtractedText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource SurfaceAltBrush}"
                                 BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                 FontSize="12" FontFamily="Segoe UI" Padding="14">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style>
                            </TextBox.Resources>
                        </TextBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False" Margin="0,0,0,10"
                                    Visibility="{Binding ExtractedText, Converter={StaticResource StrEmptyVis}}">
                            <fa:IconImage Icon="FileCirclePlus" Width="34" Height="34"
                                          Foreground="{DynamicResource TextSubtleBrush}"
                                          HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Arrastra un documento o pega el texto aquí"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="La vista previa aparecerá en este espacio."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Barra de acción IA -->
                <Border Grid.Row="3" Background="{DynamicResource PrimaryBrush}" CornerRadius="16" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding ExtractTasksWithAiCommand}"
                                Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                                Padding="20,10">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Magic" Width="14" Height="14"
                                              Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Extraer tareas con IA" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentInkBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
