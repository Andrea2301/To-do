<Window x:Class="DoItNow.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoItNow · Seguridad"
        Width="430" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="24,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.35"
                              Color="{DynamicResource WindowShadowColor}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PrimaryBrush}"
                            Margin="0,0,12,0">
                        <TextBlock Text="🔐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Contraseña" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="MessageText" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="320" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click" ToolTip="Cerrar">
                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
            </Grid>

            <!-- Password -->
            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                <TextBlock Text="CONTRASEÑA" FontSize="9" FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource SurfaceInputBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        CornerRadius="10">
                    <PasswordBox x:Name="FirstPassword" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 FontSize="13" Padding="12,9"
                                 KeyDown="Password_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- Confirmation -->
            <StackPanel x:Name="ConfirmPanel" Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="REPITE LA CONTRASEÑA" FontSize="9" FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource SurfaceInputBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        CornerRadius="10">
                    <PasswordBox x:Name="SecondPassword" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 FontSize="13" Padding="12,9"
                                 KeyDown="Password_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- Error -->
            <TextBlock x:Name="ErrorText" Grid.Row="3" Text="" Visibility="Collapsed"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerTextBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>

            <!-- Actions -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Click="Cancel_Click"
                        Background="{DynamicResource SurfaceMutedBrush}" BorderThickness="0"
                        Cursor="Hand" Padding="18,9" Margin="0,0,8,0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                    <TextBlock Text="Cancelar" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnMutedBrush}"/>
                </Button>

                <Button Grid.Column="2" Click="Ok_Click"
                        Background="{DynamicResource AccentBrush}" BorderThickness="0"
                        Cursor="Hand" Padding="20,9">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                    <TextBlock Text="Confirmar" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource AccentInkBrush}"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
