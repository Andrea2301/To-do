<Window x:Class="DoItNow.Views.DriveBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DoItNow.Converters"
        Title="DoItNow · Google Drive"
        Width="640" SizeToContent="Height" MaxHeight="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToInverseVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="24,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.35"
                              Color="{DynamicResource WindowShadowColor}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="☁" FontSize="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Respaldo en Google Drive" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Sube el vault cifrado a la carpeta privada de la app. Drive solo guarda bytes."
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click" ToolTip="Cerrar">
                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
            </Grid>

            <!-- Credenciales OAuth -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="14"
                    Padding="16,14" Margin="0,0,0,14"
                    Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="CREDENCIALES DE GOOGLE CLOUD" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Crea un cliente OAuth de tipo «Aplicación de escritorio» y pega aquí sus datos. Se guardan cifrados en este equipo."
                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock Text="CLIENT ID" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource SurfaceInputBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                            CornerRadius="10" Margin="0,0,0,10">
                        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>
                    </Border>

                    <TextBlock Text="CLIENT SECRET" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource SurfaceInputBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                            CornerRadius="10">
                        <PasswordBox x:Name="SecretBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     FontSize="12" Padding="10,8"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Click="SaveCredentials_Click"
                                IsEnabled="{Binding IsNotBusy}">
                            <TextBlock Text="Guardar credenciales" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentInkBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding OpenConsoleCommand}">
                            <TextBlock Text="Abrir Google Cloud Console" FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="CancelCredentials_Click"
                                Visibility="{Binding HasCredentials, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Cancelar" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Cuenta -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="14"
                    Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <Run Text="●" Foreground="{DynamicResource AccentBrush}"/><Run Text=" Conectado a Google Drive"/>
                        </TextBlock>
                        <TextBlock Text="○ Sin conectar" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedStrongBrush}"
                                   Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}"/>
                        <TextBlock Text="Solo se accede a la carpeta oculta appDataFolder de DoItNow."
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="Conectar cuenta" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentInkBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Desconectar" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding EditCredentialsCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Credenciales" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Acciones -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource AccentButton}"
                        Command="{Binding BackupNowCommand}" IsEnabled="{Binding CanInteract}">
                    <TextBlock Text="⬆ Respaldar ahora" FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource AccentInkBrush}"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}" IsEnabled="{Binding CanInteract}">
                    <TextBlock Text="↻ Actualizar" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnMutedBrush}"/>
                </Button>
            </Grid>

            <!-- Lista de respaldos -->
            <StackPanel Grid.Row="4">
                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,0,6">
                    <Run Text="RESPALDOS EN DRIVE"/>
                </TextBlock>

                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="12"
                        Padding="14,18"
                        Visibility="{Binding HasBackups, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="Todavía no hay respaldos. Conecta la cuenta y pulsa «Respaldar ahora»."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>

                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10"
                                        Padding="12,9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="9.5"
                                                       Foreground="{DynamicResource TextMutedStrongBrush}"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding DisplayDate, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding DisplaySize, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Padding="10,6"
                                                    ToolTip="Restaurar este respaldo"
                                                    IsEnabled="{Binding DataContext.CanInteract,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.RestoreCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="↺" FontSize="12"
                                                           Foreground="{DynamicResource TextOnMutedBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="10,6"
                                                    Margin="6,0,0,0" ToolTip="Eliminar de Drive"
                                                    IsEnabled="{Binding DataContext.CanInteract,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="🗑" FontSize="11"
                                                           Foreground="{DynamicResource DangerTextBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Estado -->
            <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" FontSize="10.5"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,12,0,0"/>
        </Grid>
    </Border>
</Window>
