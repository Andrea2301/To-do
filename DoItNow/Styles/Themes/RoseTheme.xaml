<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DoItNow · Rosé theme
         Soft blush surfaces with a vivid rose accent.
         ============================================================ -->

    <!-- Base / window -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2C6D6" Offset="0"/>
        <GradientStop Color="#E6A9BF" Offset="0.55"/>
        <GradientStop Color="#EDBBCB" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlowBrush" Color="#FFFFFF" Opacity="0.22"/>
    <Color x:Key="WindowShadowColor">#6B3B4B</Color>
    <Color x:Key="CardShadowColor">#7A4657</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFCFD"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF4F8"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FBE8EF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F7DCE7"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="#FDF2F6"/>
    <SolidColorBrush x:Key="SurfaceInputAltBrush" Color="#FFF6FA"/>
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#F8E7EE"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#FBE3EC"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#F2D3DF"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#EBC2D2"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3A1F2A"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#552F3E"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8C5A6D"/>
    <SolidColorBrush x:Key="TextMutedStrongBrush" Color="#8A5568"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A06E80"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#B08092"/>
    <SolidColorBrush x:Key="TextOnMutedBrush" Color="#6E4052"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFF2F7"/>
    <SolidColorBrush x:Key="HeaderSubtleBrush" Color="#F8D7E4"/>
    <SolidColorBrush x:Key="StatLabelBrush" Color="#FBE2EC"/>

    <!-- Primary / accents -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4B2837"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#633648"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#704052"/>
    <SolidColorBrush x:Key="RailHoverBrush" Color="#B06A83"/>
    <SolidColorBrush x:Key="RailIconBrush" Color="#FFF3F8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7AA8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F76698"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#3A0F20"/>
    <SolidColorBrush x:Key="AccentInkDeepBrush" Color="#2C0717"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FADDE4"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#A3133F"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarPanelBrush" Color="#B56C84"/>
    <SolidColorBrush x:Key="CalendarTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalendarSubTextBrush" Color="#FBE2EC"/>
    <SolidColorBrush x:Key="CalendarDayHoverBrush" Color="#C58096"/>
    <SolidColorBrush x:Key="CalendarSelectedBrush" Color="#4B2837"/>
    <SolidColorBrush x:Key="CalendarSelectedTextBrush" Color="#FFF3F8"/>
    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#FF7AA8"/>
    <SolidColorBrush x:Key="CalendarTodayTextBrush" Color="#3A0F20"/>
    <SolidColorBrush x:Key="TimelineLineBrush" Color="#EFC9D7"/>
    <SolidColorBrush x:Key="TimelineDotBrush" Color="#B56C84"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#FBE8EF"/>

    <!-- Task cards -->
    <SolidColorBrush x:Key="TaskCardHighBrush" Color="#FF7AA8"/>
    <SolidColorBrush x:Key="TaskCardMediumBrush" Color="#C58096"/>
    <SolidColorBrush x:Key="TaskCardLowBrush" Color="#FBE2EC"/>
    <SolidColorBrush x:Key="TaskCardHighTextBrush" Color="#3A0F20"/>
    <SolidColorBrush x:Key="TaskCardMediumTextBrush" Color="#3A1F2A"/>
    <SolidColorBrush x:Key="TaskCardLowTextBrush" Color="#3A1F2A"/>
    <SolidColorBrush x:Key="CheckboxBorderBrush" Color="#C9879C"/>
    <SolidColorBrush x:Key="BellBrush" Color="#633648"/>

</ResourceDictionary>
