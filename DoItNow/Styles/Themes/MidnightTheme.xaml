<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DoItNow · Midnight theme
         Deep navy surfaces with an electric blue accent.
         ============================================================ -->

    <!-- Base / window -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1026" Offset="0"/>
        <GradientStop Color="#050916" Offset="0.55"/>
        <GradientStop Color="#0A1230" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlowBrush" Color="#4F7DFF" Opacity="0.22"/>
    <Color x:Key="WindowShadowColor">#000000</Color>
    <Color x:Key="CardShadowColor">#000000</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111A33"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#16213F"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#1A2749"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#203156"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="#15203C"/>
    <SolidColorBrush x:Key="SurfaceInputAltBrush" Color="#182442"/>
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#141D36"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#1B2848"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#24345B"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#2E4270"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF3FF"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#DDE7FF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9FB2D8"/>
    <SolidColorBrush x:Key="TextMutedStrongBrush" Color="#92A6CE"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A9FC8"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#7C90B8"/>
    <SolidColorBrush x:Key="TextOnMutedBrush" Color="#D2DFFF"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#D9E4FF"/>
    <SolidColorBrush x:Key="HeaderSubtleBrush" Color="#B7C8EE"/>
    <SolidColorBrush x:Key="StatLabelBrush" Color="#C5D5F7"/>

    <!-- Primary / accents -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1B2A52"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#253A6B"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#20345F"/>
    <SolidColorBrush x:Key="RailHoverBrush" Color="#2A4070"/>
    <SolidColorBrush x:Key="RailIconBrush" Color="#EAF1FF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5EA8FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#4C94F5"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#061327"/>
    <SolidColorBrush x:Key="AccentInkDeepBrush" Color="#04101F"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1C2A"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF9EB5"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarPanelBrush" Color="#17264A"/>
    <SolidColorBrush x:Key="CalendarTextBrush" Color="#F0F5FF"/>
    <SolidColorBrush x:Key="CalendarSubTextBrush" Color="#C0D0F0"/>
    <SolidColorBrush x:Key="CalendarDayHoverBrush" Color="#243B6A"/>
    <SolidColorBrush x:Key="CalendarSelectedBrush" Color="#4F9DFF"/>
    <SolidColorBrush x:Key="CalendarSelectedTextBrush" Color="#061327"/>
    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#5EA8FF"/>
    <SolidColorBrush x:Key="CalendarTodayTextBrush" Color="#061327"/>
    <SolidColorBrush x:Key="TimelineLineBrush" Color="#2A3E68"/>
    <SolidColorBrush x:Key="TimelineDotBrush" Color="#5EA8FF"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#1B2A4D"/>

    <!-- Task cards -->
    <SolidColorBrush x:Key="TaskCardHighBrush" Color="#4F9DFF"/>
    <SolidColorBrush x:Key="TaskCardMediumBrush" Color="#2F4A7E"/>
    <SolidColorBrush x:Key="TaskCardLowBrush" Color="#1B2848"/>
    <SolidColorBrush x:Key="TaskCardHighTextBrush" Color="#061327"/>
    <SolidColorBrush x:Key="TaskCardMediumTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TaskCardLowTextBrush" Color="#DCE7FF"/>
    <SolidColorBrush x:Key="CheckboxBorderBrush" Color="#5B729F"/>
    <SolidColorBrush x:Key="BellBrush" Color="#253A6B"/>

</ResourceDictionary>
