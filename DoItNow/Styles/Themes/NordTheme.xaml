<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DoItNow · Nord theme
         Arctic slate surfaces with a frost-blue accent.
         ============================================================ -->

    <!-- Base / window -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B4252" Offset="0"/>
        <GradientStop Color="#2E3440" Offset="0.55"/>
        <GradientStop Color="#434C5E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlowBrush" Color="#88C0D0" Opacity="0.18"/>
    <Color x:Key="WindowShadowColor">#000000</Color>
    <Color x:Key="CardShadowColor">#000000</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2E3440"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#353C4A"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#3B4252"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#434C5E"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="#333A48"/>
    <SolidColorBrush x:Key="SurfaceInputAltBrush" Color="#38404E"/>
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#303744"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#3B4252"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#434C5E"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#4C566A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8C2D4"/>
    <SolidColorBrush x:Key="TextMutedStrongBrush" Color="#AEB9CC"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A3AFC3"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#94A1B7"/>
    <SolidColorBrush x:Key="TextOnMutedBrush" Color="#D8DEE9"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="HeaderSubtleBrush" Color="#C7D1E0"/>
    <SolidColorBrush x:Key="StatLabelBrush" Color="#D3DBE7"/>

    <!-- Primary / accents -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B4252"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4C566A"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#434C5E"/>
    <SolidColorBrush x:Key="RailHoverBrush" Color="#4C566A"/>
    <SolidColorBrush x:Key="RailIconBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#88C0D0"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#81A1C1"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#1E2A33"/>
    <SolidColorBrush x:Key="AccentInkDeepBrush" Color="#162028"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#4A2B34"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#E39AA2"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarPanelBrush" Color="#3B4252"/>
    <SolidColorBrush x:Key="CalendarTextBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="CalendarSubTextBrush" Color="#C7D1E0"/>
    <SolidColorBrush x:Key="CalendarDayHoverBrush" Color="#4C566A"/>
    <SolidColorBrush x:Key="CalendarSelectedBrush" Color="#88C0D0"/>
    <SolidColorBrush x:Key="CalendarSelectedTextBrush" Color="#1E2A33"/>
    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#88C0D0"/>
    <SolidColorBrush x:Key="CalendarTodayTextBrush" Color="#1E2A33"/>
    <SolidColorBrush x:Key="TimelineLineBrush" Color="#4C566A"/>
    <SolidColorBrush x:Key="TimelineDotBrush" Color="#88C0D0"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#3B4252"/>

    <!-- Task cards -->
    <SolidColorBrush x:Key="TaskCardHighBrush" Color="#88C0D0"/>
    <SolidColorBrush x:Key="TaskCardMediumBrush" Color="#4C566A"/>
    <SolidColorBrush x:Key="TaskCardLowBrush" Color="#3B4252"/>
    <SolidColorBrush x:Key="TaskCardHighTextBrush" Color="#1E2A33"/>
    <SolidColorBrush x:Key="TaskCardMediumTextBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TaskCardLowTextBrush" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="CheckboxBorderBrush" Color="#6C7A91"/>
    <SolidColorBrush x:Key="BellBrush" Color="#4C566A"/>

</ResourceDictionary>
