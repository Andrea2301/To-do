<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DoItNow · Ocean theme
         Deep teal surfaces with a fresh aqua accent.
         ============================================================ -->

    <!-- Base / window -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#062B2E" Offset="0"/>
        <GradientStop Color="#04191C" Offset="0.55"/>
        <GradientStop Color="#08383A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlowBrush" Color="#2DD4BF" Opacity="0.18"/>
    <Color x:Key="WindowShadowColor">#000000</Color>
    <Color x:Key="CardShadowColor">#000000</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0E2F31"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#123B3D"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#164548"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1C5356"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="#11393B"/>
    <SolidColorBrush x:Key="SurfaceInputAltBrush" Color="#143F41"/>
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#0F3436"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#164548"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#1D4F52"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#2A6165"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9FFFB"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#D5F7F0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93C9C3"/>
    <SolidColorBrush x:Key="TextMutedStrongBrush" Color="#8AC0BA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7FB5AF"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#72A8A2"/>
    <SolidColorBrush x:Key="TextOnMutedBrush" Color="#CFF4EE"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#D6F7F2"/>
    <SolidColorBrush x:Key="HeaderSubtleBrush" Color="#B4E3DC"/>
    <SolidColorBrush x:Key="StatLabelBrush" Color="#C2EDE6"/>

    <!-- Primary / accents -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0B383A"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#124A4C"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#104447"/>
    <SolidColorBrush x:Key="RailHoverBrush" Color="#175457"/>
    <SolidColorBrush x:Key="RailIconBrush" Color="#E8FFFB"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3CE0C4"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#35D6BA"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#052220"/>
    <SolidColorBrush x:Key="AccentInkDeepBrush" Color="#031A16"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3D1F2A"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFA3A3"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarPanelBrush" Color="#104042"/>
    <SolidColorBrush x:Key="CalendarTextBrush" Color="#EFFFFC"/>
    <SolidColorBrush x:Key="CalendarSubTextBrush" Color="#BEE7E1"/>
    <SolidColorBrush x:Key="CalendarDayHoverBrush" Color="#19575A"/>
    <SolidColorBrush x:Key="CalendarSelectedBrush" Color="#3CE0C4"/>
    <SolidColorBrush x:Key="CalendarSelectedTextBrush" Color="#052220"/>
    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#3CE0C4"/>
    <SolidColorBrush x:Key="CalendarTodayTextBrush" Color="#052220"/>
    <SolidColorBrush x:Key="TimelineLineBrush" Color="#1D5356"/>
    <SolidColorBrush x:Key="TimelineDotBrush" Color="#3CE0C4"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#164548"/>

    <!-- Task cards -->
    <SolidColorBrush x:Key="TaskCardHighBrush" Color="#3CE0C4"/>
    <SolidColorBrush x:Key="TaskCardMediumBrush" Color="#1F6265"/>
    <SolidColorBrush x:Key="TaskCardLowBrush" Color="#164548"/>
    <SolidColorBrush x:Key="TaskCardHighTextBrush" Color="#052220"/>
    <SolidColorBrush x:Key="TaskCardMediumTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TaskCardLowTextBrush" Color="#D6F7F2"/>
    <SolidColorBrush x:Key="CheckboxBorderBrush" Color="#3E7C7E"/>
    <SolidColorBrush x:Key="BellBrush" Color="#124A4C"/>

</ResourceDictionary>
