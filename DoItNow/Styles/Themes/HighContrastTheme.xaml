<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DoItNow · High contrast theme
         Pure black surfaces, white text and a high-visibility yellow
         accent for maximum readability.
         ============================================================ -->

    <!-- Base / window -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#000000" Offset="0"/>
        <GradientStop Color="#000000" Offset="0.55"/>
        <GradientStop Color="#000000" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlowBrush" Color="#FFFFFF" Opacity="0.10"/>
    <Color x:Key="WindowShadowColor">#000000</Color>
    <Color x:Key="CardShadowColor">#000000</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#141414"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#262600"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SurfaceInputAltBrush" Color="#101010"/>
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#B3B3B3"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="TextMutedStrongBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="TextOnMutedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderSubtleBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatLabelBrush" Color="#FFFFFF"/>

    <!-- Primary / accents -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#262600"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3A3A00"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#333300"/>
    <SolidColorBrush x:Key="RailHoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="RailIconBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFE500"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFE500"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#000000"/>
    <SolidColorBrush x:Key="AccentInkDeepBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A0000"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF8080"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarPanelBrush" Color="#000000"/>
    <SolidColorBrush x:Key="CalendarTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalendarSubTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalendarDayHoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="CalendarSelectedBrush" Color="#FFE500"/>
    <SolidColorBrush x:Key="CalendarSelectedTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#FFE500"/>
    <SolidColorBrush x:Key="CalendarTodayTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="TimelineLineBrush" Color="#808080"/>
    <SolidColorBrush x:Key="TimelineDotBrush" Color="#FFE500"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#333333"/>

    <!-- Task cards -->
    <SolidColorBrush x:Key="TaskCardHighBrush" Color="#FFE500"/>
    <SolidColorBrush x:Key="TaskCardMediumBrush" Color="#808080"/>
    <SolidColorBrush x:Key="TaskCardLowBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TaskCardHighTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="TaskCardMediumTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="TaskCardLowTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckboxBorderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BellBrush" Color="#333333"/>

</ResourceDictionary>
