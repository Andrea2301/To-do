<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DoItNow · Sepia theme
         Warm paper surfaces with amber accents, easy on the eyes.
         ============================================================ -->

    <!-- Base / window -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C9B18B" Offset="0"/>
        <GradientStop Color="#B79A71" Offset="0.55"/>
        <GradientStop Color="#C4A97F" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlowBrush" Color="#FFF6E6" Opacity="0.20"/>
    <Color x:Key="WindowShadowColor">#4A3824</Color>
    <Color x:Key="CardShadowColor">#5A462E</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF7"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FBF5E8"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F4EAD7"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDE0C6"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="#FAF3E4"/>
    <SolidColorBrush x:Key="SurfaceInputAltBrush" Color="#FCF6EA"/>
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#EFE6D2"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#F1E5CD"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#E4D5B8"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#D9C6A2"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2F2618"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#4A3B25"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7A6546"/>
    <SolidColorBrush x:Key="TextMutedStrongBrush" Color="#7C6747"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#937D5C"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#A38D6C"/>
    <SolidColorBrush x:Key="TextOnMutedBrush" Color="#5C4A30"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#F7EEDC"/>
    <SolidColorBrush x:Key="HeaderSubtleBrush" Color="#EBDDC2"/>
    <SolidColorBrush x:Key="StatLabelBrush" Color="#F0E3CC"/>

    <!-- Primary / accents -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4A3A24"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#5E4A2F"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#6B5438"/>
    <SolidColorBrush x:Key="RailHoverBrush" Color="#A58A62"/>
    <SolidColorBrush x:Key="RailIconBrush" Color="#FBF3E3"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E8B84B"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3AF3E"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#2F2618"/>
    <SolidColorBrush x:Key="AccentInkDeepBrush" Color="#3A2200"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F8DDD3"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#9A3412"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarPanelBrush" Color="#9C7F55"/>
    <SolidColorBrush x:Key="CalendarTextBrush" Color="#FFF9EE"/>
    <SolidColorBrush x:Key="CalendarSubTextBrush" Color="#F0E1C6"/>
    <SolidColorBrush x:Key="CalendarDayHoverBrush" Color="#AE9168"/>
    <SolidColorBrush x:Key="CalendarSelectedBrush" Color="#4A3A24"/>
    <SolidColorBrush x:Key="CalendarSelectedTextBrush" Color="#FFF7E6"/>
    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#E8B84B"/>
    <SolidColorBrush x:Key="CalendarTodayTextBrush" Color="#2F2618"/>
    <SolidColorBrush x:Key="TimelineLineBrush" Color="#D2BE9A"/>
    <SolidColorBrush x:Key="TimelineDotBrush" Color="#9C7F55"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#F4EAD7"/>

    <!-- Task cards -->
    <SolidColorBrush x:Key="TaskCardHighBrush" Color="#E8B84B"/>
    <SolidColorBrush x:Key="TaskCardMediumBrush" Color="#A58A62"/>
    <SolidColorBrush x:Key="TaskCardLowBrush" Color="#F0E3CC"/>
    <SolidColorBrush x:Key="TaskCardHighTextBrush" Color="#2F2618"/>
    <SolidColorBrush x:Key="TaskCardMediumTextBrush" Color="#2F2618"/>
    <SolidColorBrush x:Key="TaskCardLowTextBrush" Color="#2F2618"/>
    <SolidColorBrush x:Key="CheckboxBorderBrush" Color="#A58A62"/>
    <SolidColorBrush x:Key="BellBrush" Color="#5E4A2F"/>

</ResourceDictionary>
