<Window x:Class="DoItNow.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoItNow"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
       Background="{x:Null}"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered">

    <materialDesign:Card Background="White"
                         UniformCornerRadius="20"
                         materialDesign:ShadowAssist.Darken="True"
                         Margin="0,0,-25,-25"
                         Width="750"
                         Height="395"
                         >


        <Grid Margin="10,10,45,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="285" Width="438">
                <Image Source="Assets/To do list-amico.png" Width="438" Height="285"></Image>
            </StackPanel>

            <TextBlock Text="DoItNow" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,150,0,0" FontFamily="Cascadia Code SemiBold" FontSize="30" Grid.Column="1" Height="28" Width="155"/>

            <TextBlock Text="Loading..." Margin="0,190,300,138" Grid.Column="1" FontSize="15" Foreground="#FF3D01AD" FontFamily="Cascadia Code" />
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" HorizontalAlignment="Left" Height="4" Margin="419,212,0,0" VerticalAlignment="Top" Width="246" Grid.ColumnSpan="2" Foreground="#FF3D01AD" BorderBrush="White" Value="-2" ValueChanged="ProgressBar_ValueChanged" />


        </Grid>



    </materialDesign:Card>
</Window>
